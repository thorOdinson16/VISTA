# VISTA configuration (copy to .env and adjust as needed)

# LLM provider: rule-based | openai | anthropic | ollama
VISTA_LLM_PROVIDER=rule-based
VISTA_OPENAI_API_KEY=
VISTA_ANTHROPIC_API_KEY=
VISTA_OLLAMA_BASE_URL=http://localhost:11434
VISTA_OLLAMA_MODEL=llama3

# Semantic retrieval (optional; only active for providers with embeddings)
VISTA_EMBEDDING_MODEL=text-embedding-3-small
VISTA_SEMANTIC_RETRIEVAL_THRESHOLD=0.85

# Detection: real | openvocab | hybrid | synthetic (demo/tests only).
#   real      = YOLO ONNX via cv2.dnn (fast, COCO classes)
#   openvocab = YOLO-World text-prompted labels (coin, shelf, ...)
#   owlv2     = OWLv2 (slower, far better on small/thin objects;
#               uv sync --group owlv2)
#   hybrid    = real, falling back to openvocab when nothing is found
# "real" with no model is an explicit error, never a silent downgrade.
VISTA_DETECTOR_MODE=real
# Explicit model path; when empty, the first data/models/*.onnx is used
VISTA_YOLO_MODEL_PATH=
# Optional: JSON/text file with custom class names for a custom ONNX model
VISTA_YOLO_CLASS_NAMES_PATH=
# Optional: JSON file mapping raw detector labels -> canonical categories
# (e.g. {"book": "notebook", "dining table": "desk"})
VISTA_DETECTOR_LABEL_MAP=
# Open-vocabulary (YOLO-World) labels, comma-separated
VISTA_DETECTOR_LABELS=coin,key,wallet,pen,remote,phone,phone charger,charging cable,power adapter,earbuds,glasses,watch,mug,bottle,notebook,laptop,backpack,person,chair,tablet
VISTA_OPENVOCAB_MODEL=yolov8s-worldv2.pt
VISTA_OWLV2_MODEL=google/owlv2-base-patch16-ensemble
VISTA_MODEL_SIZE=yolov8s
VISTA_DETECTION_CONFIDENCE_THRESHOLD=0.25

# Tracking / occlusion / re-identification
VISTA_TRACKING_IOU_THRESHOLD=0.3
VISTA_OCCLUSION_TOLERANCE_FRAMES=30
VISTA_REID_SIMILARITY_THRESHOLD=0.6

# Frame sampling: adaptive | fixed | all
VISTA_SAMPLING_STRATEGY=adaptive
VISTA_SAMPLING_FPS=2.0

# Scene change (MOG2 foreground; suppressed under camera motion)
VISTA_SCENE_CHANGE_THRESHOLD=0.15
VISTA_SCENE_CHANGE_MOTION_GATE=2.0

# Generic unknown-object fallback (opt-in). MOG2 assumes a static camera;
# on handheld footage it can produce false objects, so it is off by default.
VISTA_SALIENCY_FALLBACK=false
VISTA_SALIENCY_MIN_AREA=600
VISTA_SALIENCY_MIN_PERSISTENCE_OVERLAP=0.1
